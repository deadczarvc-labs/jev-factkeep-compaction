{
  "name": "fast-jev-compaction",
  "version": "0.2.0",
  "description": "Continuous, verbatim context compaction for LLM agents using TypeSafe's Jev model.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".claude-plugin/plugin.json",
    ".codex-plugin",
    "codex-dist/src",
    "codex-dist/codex",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:codex": "tsc -p tsconfig.codex-build.json",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks && tsc -p tsconfig.codex.json",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
