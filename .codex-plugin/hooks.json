{
  "description": "Restore local tool-output facts only after Codex compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-dist/codex/fact-sheet.js\"",
            "timeout": 30,
            "statusMessage": "Restoring tool-output facts after compaction",
            "additionalContextLimit": 70000
          }
        ]
      }
    ]
  }
}
